---
import Navbar from './Navbar.astro';
---
<section class="hero">
  <div class="hero__canvas">
    <div class="hero__blob-top" aria-hidden="true"></div>
    <div class="hero__blob-bottom"></div>
    <div class="hero__diagonal" aria-hidden="true"></div>
    <img class="hero__badge-logo" src="/assets/evir-logo-cropped.png" alt="e-VIR" />

    <Navbar />

    <div class="hero__content">
      <span class="hero__eyebrow">Vuela como un canario</span>
      <h1 class="hero__headline">Silencioso.<br />Suave. Libre.</h1>
      <p class="hero__desc">Vehículos eléctricos nuevos y automáticos, con un modelo en el que el conductor termina siendo dueño.</p>
      <a class="btn btn--primary btn--md hero__cta" href="#socio">Quiero mi e-VIR</a>
      <div class="hero__stats">
        <div class="hero__stat">
          <span class="hero__stat-value">25</span>
          <span class="hero__stat-label">Meta flota 2026</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">200</span>
          <span class="hero__stat-label">Meta flota 2027</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">4</span>
          <span class="hero__stat-label">Países</span>
        </div>
        <div class="hero__stat">
          <span class="hero__stat-value">$0</span>
          <span class="hero__stat-label">Cuota inicial</span>
        </div>
      </div>
    </div>

    <img class="hero__car" src="/assets/carro-e10x.png" alt="e-VIR JMEV 2 — vehículo eléctrico" />
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    min-height: 560px;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    background: var(--surface-ink);
  }

  /* Everything inside is laid out at a fixed 1920x780 design size, then
     scaled as one unit to fit the real viewport — so the car, the
     diagonal panel and the text keep the exact same relative position and
     proportions to each other on every screen (like a single scaled
     image), instead of each piece reflowing independently.
     The scale factor is computed in JS (see the script below), not with
     vw/dvh: dvh and vh disagreed with each other and with the browser's
     real, live innerWidth/innerHeight across zoom levels in testing,
     which is exactly the sliver of error a "never scroll" requirement
     can't absorb. window.innerWidth/innerHeight are the actual numbers
     the browser is laying out against, no unit ambiguity. It picks the
     smaller of a width-match (flush right edge, the normal case) and a
     height-match (a small gap after the panel instead of a scrollbar, on
     a screen too short for the design at full width) and writes it to
     --hero-scale. The calc() fallback only covers the instant before
     that script runs. */
  .hero__canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 1920px;
    height: 780px;
    transform-origin: top left;
    transform: scale(var(--hero-scale, calc(100vw / 1920px)));
  }

  .hero__blob-top {
    position: absolute;
    left: 0;
    top: 0;
    width: 190px;
    height: 138px;
    background: transparent;
    border-radius: 0 0 100% 0;
    z-index: 2;
  }

  /* Independent of the navbar on purpose: the navbar centers its links
     across the full bar and no longer reserves a column for the logo, so
     this is positioned solely against the gray badge shape's own curve
     (a quarter-ellipse anchored at the top-left corner) — not against
     nav padding, which would drift as the links block resizes. */
  .hero__badge-logo {
    position: absolute;
    left: 8px;
    top: 8px;
    height: 58px;
    width: auto;
    z-index: 6;
  }

  .hero__blob-bottom {
    display: none;
  }

  .hero__diagonal {
  position: absolute;
  inset: 0;
  z-index: 3;
  background: var(--surface-lime);

  clip-path: polygon(
    100% 10.6%,
    55.5% 65.5%,

    54.8% 67.5%,
    54.0% 70%,
    53.0% 73%,
    52.2% 76%,
    51.7% 79%,
    51.5% 82%,
    51.5% 85%,
    51.8% 88%,
    52.2% 91%,
    52.8% 94%,
    53.5% 97%,
    54.2% 100%,

    100% 100%
  );
    pointer-events: none;
  }

  .hero__content {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    width: 560px;
    z-index: 5;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 18px;
    padding: 150px 36px 88px 56px;
  }

  .hero__eyebrow {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: var(--fw-bold);
    font-size: 26px;
    line-height: 1;
    color: var(--evir-lime-400);
  }

  .hero__headline {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--fw-extrabold);
    font-size: 54px;
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
    color: var(--text-inverse);
  }

  .hero__desc {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: var(--lh-body);
    color: var(--text-inverse-muted);
    max-width: 30em;
  }

  .hero__cta { align-self: flex-start; margin-top: 10px; }

  .hero__stats {
    display: flex;
    gap: 26px;
    margin-top: 24px;
    flex-wrap: nowrap;
  }

  .hero__stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-right: 26px;
    border-right: 1px solid var(--border-inverse);
    flex: 0 0 auto;
  }
  .hero__stat:last-child { border-right: none; padding-right: 0; }

  .hero__stat-value {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: var(--fw-extrabold);
    color: var(--text-inverse);
    line-height: 1;
    white-space: nowrap;
  }

  .hero__stat-label {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: var(--fw-semibold);
    color: var(--text-inverse-muted);
    white-space: nowrap;
  }

  .hero__car {
    position: absolute;
    right: 1.5%;
    bottom: 2.5%;
    width: 880px;
    z-index: 4;
    pointer-events: none;
  }

  @media (max-width: 680px) {
    .hero {
      height: auto;
      min-height: 100vh;
      padding-bottom: var(--space-9);
    }

    .hero__canvas {
      position: relative;
      top: auto;
      left: auto;
      width: auto;
      height: auto;
      transform: none;
    }

    .hero__blob-top {
      width: 130px;
      height: 96px;
    }

    .hero__badge-logo {
      display: none;
    }

    .hero__diagonal {
      display: none;
    }

    .hero__content {
      position: relative;
      width: auto;
      height: auto;
      padding: 96px var(--gutter-inline) 0;
    }

    .hero__cta {
      align-self: stretch;
    }

    .hero__stats {
      flex-wrap: wrap;
      justify-content: center;
      gap: 16px 24px;
    }
    .hero__stat {
      align-items: center;
      text-align: center;
      min-width: 42%;
      border-right: none;
      padding-right: 0;
    }
    .hero__stat:nth-child(odd) {
      border-right: 1px solid var(--border-inverse);
      padding-right: 16px;
    }

    .hero__car {
      position: relative;
      inset: auto;
      display: block;
      width: min(420px, 92%);
      margin: 32px auto 0;
    }
  }
</style>

<script>
  const DESIGN_WIDTH = 1920;
  const DESIGN_HEIGHT = 780;
  const HEIGHT_BUFFER = 8;

  function updateHeroScale() {
    const scale = Math.min(
      window.innerWidth / DESIGN_WIDTH,
      (window.innerHeight - HEIGHT_BUFFER) / DESIGN_HEIGHT
    );
    document.documentElement.style.setProperty('--hero-scale', String(scale));
  }

  updateHeroScale();
  window.addEventListener('resize', updateHeroScale);
</script>
