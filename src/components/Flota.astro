---
const SPECS = [
  { value: "Automático", label: "Transmisión" },
  { value: "100% eléctrico", label: "Motor" },
  { value: "Nuevo", label: "Estado" },
  { value: "Flota propia", label: "Titularidad" },
];
---

<section
  class="section section--sunken"
  id="flota"
  aria-labelledby="flota-title"
>
  <div class="section__inner">
    <div class="section-head">
      <span class="evir-eyebrow">Flota</span>

      <h2 class="section-head__title" id="flota-title">
        Somos propietarios de nuestra propia flota
      </h2>

      <p class="section-head__lead">
        No intermediamos vehículos ajenos: los vehículos son nuestros, nuevos,
        eléctricos y automáticos. Eso nos permite garantizar calidad,
        mantenimiento y condiciones justas para el conductor.
      </p>
    </div>

    <div class="card card--ink flota__panel">
      <!-- IMAGEN PRINCIPAL DE LA FLOTA -->
      <div class="flota__visual">
        <img
          class="flota__image"
          src="/assets/e-vir-flota-computer.webp"
          alt="Flota de cinco vehículos JAC E10X eléctricos de e-VIR"
          loading="lazy"
          decoding="async"
          width="1536"
          height="1024"
        />
      </div>

      <!-- INFORMACIÓN DEL VEHÍCULO -->
      <div class="flota__meta">
        <div class="flota__intro">
          <div>
            <span class="flota__eyebrow">Nuestra flota</span>

            <h3 class="flota__name">JAC E10X</h3>
          </div>

          <p class="flota__description">
            Movilidad eléctrica, eficiente y confiable para una nueva generación
            de conductores.
          </p>
        </div>

        <!-- ESPECIFICACIONES -->
        <dl class="flota__specs">
          {
            SPECS.map((s) => (
              <div class="flota__spec">
                <dt class="flota__spec-label">{s.label}</dt>

                <dd class="evir-data flota__spec-value">{s.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  /* =========================================================
     FLOTA
     ========================================================= */

  .flota__panel {
    display: flex;
    flex-direction: column;
    gap: clamp(var(--space-7), 5vw, var(--space-11));

    padding: clamp(var(--space-4), 2.5vw, var(--space-7));

    border-radius: var(--radius-panel);
    overflow: hidden;
  }

  /* =========================================================
     IMAGEN
     ========================================================= */

  .flota__visual {
    position: relative;
    width: 100%;
    overflow: hidden;

    border-radius: calc(var(--radius-panel) - var(--space-2));

    background: var(--surface-ink);
  }

  .flota__image {
    display: block;

    width: 100%;
    height: auto;

    aspect-ratio: 3 / 2;

    object-fit: cover;
    object-position: center;

    /*
     * Evita que la imagen se vea como una fotografía
     * independiente pegada dentro del panel.
     */
    transform: scale(1.001);

    transition: transform var(--dur-scenic) var(--ease-standard);
  }

  .flota__visual:hover .flota__image {
    transform: scale(1.015);
  }

  /* =========================================================
     META
     ========================================================= */

  .flota__meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-7);

    width: 100%;

    padding-inline: clamp(var(--space-2), 2vw, var(--space-6));
    padding-bottom: var(--space-3);
  }

  /* =========================================================
     INTRO
     ========================================================= */

  .flota__intro {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-7);
  }

  .flota__eyebrow {
    display: block;

    margin-bottom: var(--space-2);

    font-size: var(--fs-caption);
    font-weight: var(--fw-semibold);

    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;

    color: var(--text-inverse-muted);
  }

  .flota__name {
    margin: 0;

    font-size: var(--fs-h2);
    line-height: 1;

    color: var(--text-inverse);
  }

  .flota__description {
    max-width: 420px;

    margin: 0;

    font-size: var(--fs-body);
    line-height: 1.55;

    color: var(--text-inverse-muted);
  }

  /* =========================================================
     ESPECIFICACIONES
     ========================================================= */

  .flota__specs {
    display: grid;

    grid-template-columns: repeat(4, 1fr);

    width: 100%;
    margin: 0;
    padding: var(--space-6) 0 0;

    border-top: var(--border-hairline) solid var(--border-inverse);

    text-align: left;
  }

  .flota__spec {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);

    min-width: 0;

    padding-inline: var(--space-5);

    border-right: var(--border-hairline) solid var(--border-inverse);
  }

  .flota__spec:first-child {
    padding-left: 0;
  }

  .flota__spec:last-child {
    padding-right: 0;
    border-right: 0;
  }

  .flota__spec-label {
    margin: 0;

    font-size: var(--fs-caption);
    font-weight: var(--fw-semibold);

    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;

    color: var(--text-inverse-muted);
  }

  .flota__spec-value {
    margin: 0;

    font-size: var(--fs-body);
    font-weight: var(--fw-semibold);

    color: var(--text-inverse);
  }

  /* =========================================================
     TABLET
     ========================================================= */

  @media (max-width: 900px) {
    .flota__intro {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-4);
    }

    .flota__description {
      max-width: 600px;
    }

    .flota__specs {
      grid-template-columns: repeat(2, 1fr);
      row-gap: var(--space-5);
    }

    .flota__spec:nth-child(2) {
      padding-right: 0;
      border-right: 0;
    }

    .flota__spec:nth-child(3) {
      padding-left: 0;
    }

    .flota__spec:nth-child(3),
    .flota__spec:nth-child(4) {
      padding-top: var(--space-5);

      border-top: var(--border-hairline) solid var(--border-inverse);
    }

    .flota__spec:nth-child(4) {
      padding-right: 0;
      border-right: 0;
    }
  }

  /* =========================================================
     MOBILE
     ========================================================= */

  @media (max-width: 680px) {
    .flota__panel {
      gap: var(--space-6);

      padding: var(--space-3);
    }

    .flota__visual {
      border-radius: var(--radius-panel);
    }

    .flota__image {
      /*
       * En móvil no forzamos un recorte agresivo.
       * Así siguen apareciendo los cinco vehículos.
       */
      aspect-ratio: 4 / 3;
      object-fit: cover;
      object-position: center;
    }

    .flota__meta {
      gap: var(--space-6);

      padding-inline: var(--space-2);
    }

    .flota__name {
      font-size: var(--fs-h3);
    }

    .flota__description {
      font-size: var(--fs-body);
    }

    .flota__specs {
      grid-template-columns: repeat(2, 1fr);
    }

    .flota__spec {
      padding-inline: var(--space-3);
    }

    .flota__spec:nth-child(3) {
      padding-left: 0;
    }
  }
</style>
